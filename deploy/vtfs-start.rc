#!/bin/rc
# Start vtfs if it is not already posted. Safe to source from profile.
if(test -e /srv/vt)
	exit 0

if(! test -f $home/lib/vtfs.token){
	echo 'vtfs: missing $home/lib/vtfs.token' >[1=2]
	exit missing
}

$home/bin/amd64/vtfs -s vt -M -a 'tcp!*!5640' -T $home/lib/vtfs.token &
sleep 1

if(test -e /srv/vt)
	echo vtfs started
if not
	echo vtfs failed to start >[1=2]
